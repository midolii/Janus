{
  "name": "janus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "pnpm --filter @janus/ui build:storybook",
    "check": "biome check .",
    "check:write": "biome check --write --unsafe --only=lint/nursery/useSortedClasses . && biome check --write .",
    "dev": "turbo run dev --parallel",
    "prepare": "husky",
    "storybook": "pnpm --filter @janus/ui storybook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm build:storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7",
    "turbo": "2.10.10",
    "typescript": "7.0.2"
  }
}
