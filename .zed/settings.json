{
  "$schema": "zed://schemas/settings",
  "languages": {
    "CSS": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": [
        "biome",
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "..."]
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "..."]
    },
    "JSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "tailwindcss-language-server", "..."],
      "prettier": {
        "allowed": false
      }
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "tailwindcss-language-server", "..."],
      "prettier": {
        "allowed": false
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "tailwindcss-language-server", "..."],
      "prettier": {
        "allowed": false
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "tailwindcss-language-server", "..."],
      "prettier": {
        "allowed": false
      }
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cn", "clsx", "cva"]
      }
    }
  }
}
