# Browser-side override for a deliberately cross-origin deployment.
# Keep this unset for local development and same-origin production.
# VITE_JANUS_API_BASE_URL=https://example.com/api/v1

# Optional media origin override. By default it follows VITE_JANUS_API_BASE_URL or the page origin.
# VITE_JANUS_STREAM_BASE_URL=https://example.com

# Vite dev-server proxy. These variables are server-only and are not bundled into the browser.
JANUS_DEV_API_PROXY_TARGET=https://ap-frp.midolii.com

# Optional credentials for a protected upstream. Store them only in .env.local.
# JANUS_DEV_API_PROXY_COOKIE=authelia_session=replace-me
# JANUS_DEV_API_PROXY_AUTHORIZATION=Bearer replace-me
